{
  "manifest_version": 3,
  "name": "DynIs Downloads & Media",
  "version": "1.1.0",
  "description": "Shows your downloads and what’s playing on YouTube, YouTube Music, Spotify, Apple Music and SoundCloud in the DynIs island on this PC, with its controls. Nothing leaves your computer.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "media-core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://music.apple.com/*",
        "https://soundcloud.com/*"
      ],
      "js": [
        "media-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@dynis.kevin",
      "strict_min_version": "128.0"
    }
  }
}
